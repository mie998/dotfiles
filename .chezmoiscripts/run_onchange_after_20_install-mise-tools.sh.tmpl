#!/bin/sh
# mise-config-sha256: {{ include "dot_config/mise/config.toml" | sha256sum }}
# mise-lock-sha256: {{ include "dot_config/mise/mise.lock" | sha256sum }}
# sheldon-config-sha256: {{ include "dot_config/sheldon/plugins.toml" | sha256sum }}
set -eu

if ! command -v mise >/dev/null 2>&1; then
    echo "mise must be installed by the Nix package set before chezmoi apply" >&2
    exit 1
fi

mise install --yes

if ! mise exec -- sheldon --version >/dev/null 2>&1; then
    echo "sheldon must be installed by mise before chezmoi apply" >&2
    exit 1
fi

# `mise install` installs the tool but does not modify PATH for this
# non-interactive chezmoi script. Run Sheldon through mise so the managed
# binary is available here as well as in activated login shells.
mise exec -- sheldon lock

# zeno.zsh still passes the removed Deno 1.x --unstable flag. Keep the
# plugin managed by Sheldon, but make its generated function Deno 2 compatible.
zeno_function_dir="${XDG_DATA_HOME:-$HOME/.local/share}/sheldon/repos/github.com/yuki-yano/zeno.zsh/shell/function"
if [ -f "$zeno_function_dir/zeno" ] && [ -w "$zeno_function_dir/zeno" ]; then
    sed -i.bak 's/deno run --unstable --no-check/deno run --no-check/' "$zeno_function_dir/zeno"
    rm -f "$zeno_function_dir/zeno.bak"
fi
