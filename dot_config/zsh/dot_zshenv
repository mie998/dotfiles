### locale ###
export LANG="en_US.UTF-8"

### XDG ###
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

### Runtime directory ###
runtime_probe="${XDG_RUNTIME_DIR:-}/.dotfiles-runtime-probe-$$"
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ] || ! : > "$runtime_probe" 2>/dev/null; then
    export XDG_RUNTIME_DIR="$XDG_STATE_HOME/runtime"
    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 700 "$XDG_RUNTIME_DIR"
else
    rm -f "$runtime_probe"
fi

### Zeno socket ###
export ZENO_SOCK_DIR="$XDG_RUNTIME_DIR/zeno-${UID:-$(id -u)}"
unset ZENO_SOCK

### zsh ###
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

### Rust ###
export RUST_BACKTRACE=1
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$XDG_DATA_HOME/cargo"

### Go ###
export GOPATH="$XDG_DATA_HOME/go"
export GO111MODULE="on"

### Deno ###
export DENO_INSTALL="$XDG_DATA_HOME/deno"

### mise ###
export MISE_DATA_DIR="$XDG_DATA_HOME/mise"
export MISE_INSTALL_PATH="$MISE_DATA_DIR/bin/mise"
export MISE_CACHE_DIR="$XDG_CACHE_HOME/mise"

### Nix dotfiles profile ###
export DOTFILES_NIX_PROFILE="${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/dotfiles"
export PATH="$DOTFILES_NIX_PROFILE/bin:$PATH"
